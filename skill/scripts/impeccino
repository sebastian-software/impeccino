#!/bin/sh
# Impeccino launcher. Automatic candidates must match VERSION; downloads must
# also match engine.sha256. Selection: explicit override, sibling, cache, fetch.
set -eu

dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

# The engine needs the skill directory for reference files and the launcher path
# for commands it prints. Set both before any candidate can be executed.
: "${IMPECCINO_SKILL_DIR:=$(CDPATH= cd -- "$dir/.." && pwd)}"
: "${IMPECCINO_SELF:=$0}"
export IMPECCINO_SKILL_DIR IMPECCINO_SELF

probing=${IMPECCINO_LAUNCHER_PROBE:-}
if [ -n "$probing" ]; then
  # A launcher reached as another launcher's candidate must not recurse.
  exit 127
fi

if [ -n "${IMPECCINO_BIN:-}" ]; then
  if [ ! -f "$IMPECCINO_BIN" ] || [ ! -x "$IMPECCINO_BIN" ]; then
    echo "impeccino: IMPECCINO_BIN points to a missing or non-executable file: $IMPECCINO_BIN" >&2
    exit 127
  fi
  # A developer override is explicit and may intentionally use another version.
  exec "$IMPECCINO_BIN" "$@"
fi

case "$(uname -s 2>/dev/null || echo unknown)" in
  Darwin) os=darwin ;;
  Linux) os=linux ;;
  MINGW*|MSYS*|CYGWIN*|Windows_NT) os=windows ;;
  *) os=unknown ;;
esac
case "$(uname -m 2>/dev/null || echo unknown)" in
  arm64|aarch64) arch=arm64 ;;
  x86_64|amd64) arch=x64 ;;
  *) arch=unknown ;;
esac

version=""
[ -f "$dir/VERSION" ] && version=$(tr -d '[:space:]' < "$dir/VERSION")
exe=""
[ "$os" = windows ] && exe=".exe"
bin="$dir/bin/$os-$arch/impeccino$exe"
cached=""
cache_root="${IMPECCINO_HOME:-${HOME:-/nonexistent}/.impeccino}"
cache_dir=""
failure_marker=""
if [ -n "$version" ]; then
  cache_dir="$cache_root/bin/$version"
  cached="$cache_dir/impeccino$exe"
  failure_marker="$cache_dir/.impeccino-download-failed"
fi

# The public engine-probe verb prints exactly "impeccino-engine <version>".
# Only automatic candidates are checked; IMPECCINO_BIN is intentionally free
# to point at a local build with a different version.
probe_ok() {
  expected="impeccino-engine $2"
  probe_tmp=$(mktemp "${TMPDIR:-/tmp}/impeccino-probe.XXXXXX") || return 1
  if ! IMPECCINO_LAUNCHER_PROBE=1 "$1" engine-probe >"$probe_tmp" 2>/dev/null; then
    rm -f "$probe_tmp"
    return 1
  fi
  printf '%s\n' "$expected" | cmp -s - "$probe_tmp"
  probe_status=$?
  rm -f "$probe_tmp"
  return "$probe_status"
}

if [ -n "$version" ] && [ -f "$bin" ]; then
  if [ ! -x "$bin" ]; then
    chmod +x "$bin" 2>/dev/null || true
  fi
  if [ -x "$bin" ] && probe_ok "$bin" "$version"; then
    exec "$bin" "$@"
  fi
fi

if [ -n "$version" ] && [ -x "$cached" ] && probe_ok "$cached" "$version"; then
  exec "$cached" "$@"
fi

# Last resort: fetch this version's binary for the current platform from the
# public release channel into the user cache. Needs network; sandboxes without
# egress can preinstall the pinned binary beside this script or set IMPECCINO_BIN.
setup_help() {
  echo "Engine $version setup needs network access and write permission to $cache_dir." >&2
  echo "Run this launcher ($0) with engine-probe in a terminal that has those permissions, then retry the original command." >&2
  echo "Alternatively, set IMPECCINO_HOME to a writable cache location, or IMPECCINO_BIN to a preinstalled engine binary." >&2
}

cooldown_active() {
  [ -n "$failure_marker" ] && [ -f "$failure_marker" ] || return 1
  marker_until=$(cat "$failure_marker" 2>/dev/null || true)
  now=$(date +%s 2>/dev/null || true)
  case "$marker_until" in
    ''|*[!0-9]*) rm -f "$failure_marker"; return 1 ;;
  esac
  case "$now" in
    ''|*[!0-9]*) return 1 ;;
  esac
  if [ "$now" -ge "$marker_until" ]; then
    rm -f "$failure_marker"
    return 1
  fi
  return 0
}

record_failure() {
  now=$(date +%s 2>/dev/null || true)
  case "$now" in
    ''|*[!0-9]*) return 1 ;;
  esac
  marker_tmp="$failure_marker.$$"
  if ! printf '%s\n' "$((now + 300))" > "$marker_tmp" 2>/dev/null; then
    return 1
  fi
  if ! mv -f "$marker_tmp" "$failure_marker" 2>/dev/null; then
    rm -f "$marker_tmp"
    return 1
  fi
}

fetch_url() {
  if command -v curl >/dev/null 2>&1; then
    curl -fsSL --connect-timeout 5 --max-time 60 -o "$tmp" "$1" 2>/dev/null
  elif command -v wget >/dev/null 2>&1; then
    wget --timeout=60 --tries=1 -q -O "$tmp" "$1" 2>/dev/null
  else
    return 1
  fi
}

check_download() {
  download_file=${1:-$tmp}
  if [ ! -f "$download_file" ]; then
    echo "impeccino: download completed but the file was removed before execution: $url; check your antivirus quarantine or logs. Refusing to continue; do not disable protection." >&2
    exit 127
  fi
  if [ ! -s "$download_file" ]; then
    rm -f "$download_file"
    echo "impeccino: downloaded file is empty: $url; refusing the unverified download" >&2
    exit 127
  fi
}

if [ -n "$version" ] && [ "$os" != unknown ] && [ "$arch" != unknown ]; then
  base="${IMPECCINO_DOWNLOAD_BASE:-https://github.com/sebastian-software/impeccino/releases/download}"
  asset="impeccino-$os-$arch"
  [ "$os" = windows ] && asset="$asset.exe"
  url="$base/engine-v$version/$asset"
  tmp="$cache_dir/.impeccino.part.$$"
  if ! grep -qF "  engine-v$version/" "$dir/engine.sha256" 2>/dev/null; then
    echo "impeccino: no digest pinned for engine-v$version in $dir/engine.sha256; refusing to download an unverified engine. Use a released skill version, or build the engine and set IMPECCINO_BIN." >&2
    exit 127
  fi
  if cooldown_active; then
    echo "impeccino: download of engine $version recently failed; retry after the five-minute cooldown." >&2
    setup_help
    exit 127
  fi
  if ! mkdir -p "$cache_dir" 2>/dev/null; then
    echo "impeccino: engine $version is not installed; cannot create cache directory: $cache_dir" >&2
    setup_help
    exit 127
  fi
  # Check the actual staging file, not just directory existence: a cache from
  # an earlier run can be readable but no longer writable inside a sandbox.
  if ! (umask 077; : > "$tmp") 2>/dev/null; then
    echo "impeccino: engine $version is not installed; cannot write to cache directory: $cache_dir" >&2
    setup_help
    exit 127
  fi
  fetched=0
  if fetch_url "$url"; then
    fetched=1
  elif [ "$os" = windows ] && [ "$arch" = arm64 ]; then
    # Windows on ARM runs x64 binaries; fall back when no arm64 asset exists.
    url="$base/engine-v$version/impeccino-windows-x64.exe"
    fetch_url "$url" && fetched=1
  fi
  if [ "$fetched" = 1 ]; then
    check_download
    pins="$dir/engine.sha256"
    expected=""
    if [ -f "$pins" ]; then
      key="engine-v$version/${url##*/}"
      expected=$(awk -v k="$key" '$2 == k { print $1; exit }' "$pins" 2>/dev/null || true)
    fi
    actual=""
    if command -v shasum >/dev/null 2>&1; then
      if digest=$(shasum -a 256 "$tmp" 2>/dev/null); then actual=${digest%% *}; fi
    elif command -v sha256sum >/dev/null 2>&1; then
      if digest=$(sha256sum "$tmp" 2>/dev/null); then actual=${digest%% *}; fi
    fi
    check_download
    if [ -z "$expected" ]; then
      rm -f "$tmp"
      echo "impeccino: no digest pinned for engine-v$version/${url##*/} in $pins; refusing the unverified download. Use a released skill version, or build the engine and set IMPECCINO_BIN." >&2
      exit 127
    fi
    if [ -z "$actual" ]; then
      rm -f "$tmp"
      echo "impeccino: cannot hash $url (no shasum or sha256sum); refusing the unverified download" >&2
      exit 127
    fi
    if [ "$actual" != "$expected" ]; then
      rm -f "$tmp"
      echo "impeccino: checksum mismatch downloading $url (pinned in $pins)" >&2
      exit 127
    fi
    check_download
    if ! chmod +x "$tmp" 2>/dev/null; then
      check_download
      rm -f "$tmp"
      echo "impeccino: could not make the verified download executable: $url" >&2
      exit 127
    fi
    check_download
    if ! mv -f "$tmp" "$cached" 2>/dev/null; then
      check_download
      rm -f "$tmp"
      echo "impeccino: could not cache the verified download: $url" >&2
      exit 127
    fi
    check_download "$cached"
    rm -f "$failure_marker"
    exec "$cached" "$@"
  fi
  rm -f "$tmp" 2>/dev/null
  record_failure || true
  echo "impeccino: could not download engine $version from $url; check network access, the release URL, and curl or wget availability." >&2
  setup_help
  exit 127
fi

echo "impeccino: no engine binary for $os-$arch found (looked in $bin and $cached)." >&2
echo "Download impeccino-$os-$arch from https://github.com/sebastian-software/impeccino/releases (tag engine-v$version) into $cache_dir/impeccino$exe (then chmod +x), or set IMPECCINO_BIN to a preinstalled engine binary." >&2
exit 127
