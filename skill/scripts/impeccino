#!/bin/sh
# Impeccino launcher. Runs the platform binary shipped next to this script:
#   <this dir>/bin/<os>-<arch>/impeccino
# Order: $IMPECCINO_BIN, the sibling binary, ~/.impeccino/bin/impeccino,
# the version-pinned cache, then `impeccino` on PATH. Never needs Node.
# The unversioned home binary and the PATH candidate are validated with the
# engine-probe handshake first: the retired 3.x npm CLI also installed a bin
# named `impeccino`, and exec'ing it would fail every verb with
# "Unknown command". Trusted candidates (IMPECCINO_BIN, the sibling binary,
# the version-pinned cache) are exec'd without a probe: hooks run them on
# every edit and must stay fast.
set -eu

# True when the candidate answers the engine handshake (prints
# "impeccino-engine <version>", exit 0). Quiet and fast (<100ms).
# IMPECCINO_LAUNCHER_PROBE marks the child as a probe: a copy of this
# launcher reached recursively (e.g. symlinked onto PATH as `impeccino`)
# then skips its own probes and refuses to download, so probing stays cheap
# and can never loop.
probe_ok() {
  case "$(IMPECCINO_LAUNCHER_PROBE=1 "$1" engine-probe 2>/dev/null || true)" in
    impeccino-engine*) return 0 ;;
  esac
  return 1
}
probing=${IMPECCINO_LAUNCHER_PROBE:-}

dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

# What the binary needs to know about its home: the skill directory (for
# reference/*.md and command-metadata.json) and how to name itself in the
# commands it prints. Exported BEFORE any exec below, including the
# IMPECCINO_BIN override: an engine binary reached with no IMPECCINO_SKILL_DIR
# cannot find reference/*.md, so native platform refs never inline. Setting it
# here covers every candidate the launcher can exec.
: "${IMPECCINO_SKILL_DIR:=$(CDPATH= cd -- "$dir/.." && pwd)}"
: "${IMPECCINO_SELF:=$0}"
export IMPECCINO_SKILL_DIR IMPECCINO_SELF

if [ -n "${IMPECCINO_BIN:-}" ] && [ -x "${IMPECCINO_BIN}" ]; then
  exec "${IMPECCINO_BIN}" "$@"
fi

case "$(uname -s 2>/dev/null || echo unknown)" in
  Darwin) os=darwin ;;
  Linux) os=linux ;;
  MINGW*|MSYS*|CYGWIN*|Windows_NT) os=windows ;;
  *) os=unknown ;;
esac
case "$(uname -m 2>/dev/null || echo unknown)" in
  arm64|aarch64) arch=arm64 ;;
  x86_64|amd64) arch=x64 ;;
  *) arch=unknown ;;
esac

bin="$dir/bin/$os-$arch/impeccino"
[ "$os" = windows ] && bin="$bin.exe"

if [ -x "$bin" ]; then
  exec "$bin" "$@"
fi
if [ -f "$bin" ]; then
  # Lost the executable bit in transit (zip extraction, some copiers).
  chmod +x "$bin" 2>/dev/null && exec "$bin" "$@"
fi
# On Windows (an MSYS/Git Bash shell) the cached names carry .exe so this
# launcher and impeccino.cmd share one cache.
exe=""
[ "$os" = windows ] && exe=".exe"
home_bin="${HOME:-/nonexistent}/.impeccino/bin/impeccino$exe"
if [ -z "$probing" ] && [ -x "$home_bin" ] && probe_ok "$home_bin"; then
  exec "$home_bin" "$@"
fi
# Version-pinned user cache, filled by the download below.
version=""
[ -f "$dir/VERSION" ] && version=$(tr -d '[:space:]' < "$dir/VERSION")
cache_root="${IMPECCINO_HOME:-${HOME:-/nonexistent}/.impeccino}"
cached="$cache_root/bin/$version/impeccino$exe"
if [ -n "$version" ] && [ -x "$cached" ]; then
  exec "$cached" "$@"
fi
if [ -z "$probing" ] && command -v impeccino >/dev/null 2>&1 && probe_ok impeccino; then
  exec impeccino "$@"
fi

# Last resort: fetch this version's binary for the current platform from the
# public release channel into the user cache. Needs network; sandboxes without
# egress preinstall the binary on PATH instead.
setup_help() {
  echo "Engine $version setup needs network access and write permission to $cache_root/bin/$version." >&2
  echo "Run this launcher ($0) with engine-probe in a terminal that has those permissions, then retry the original command." >&2
  echo "Alternatively, set IMPECCINO_HOME to a writable cache location, or IMPECCINO_BIN to a preinstalled engine binary." >&2
}
fetch_url() {
  if command -v curl >/dev/null 2>&1; then
    curl -fsSL --retry 2 -o "$tmp" "$1" 2>/dev/null
  elif command -v wget >/dev/null 2>&1; then
    wget -q -O "$tmp" "$1" 2>/dev/null
  else
    return 1
  fi
}
check_download() {
  download_file=${1:-$tmp}
  if [ ! -f "$download_file" ]; then
    echo "impeccino: download completed but the file was removed before execution: $url; check your antivirus quarantine or logs. Refusing to continue; do not disable protection." >&2
    exit 127
  fi
  if [ ! -s "$download_file" ]; then
    rm -f "$download_file"
    echo "impeccino: downloaded file is empty: $url; refusing the unverified download" >&2
    exit 127
  fi
}
if [ -n "$probing" ]; then
  # Inside another launcher's probe: no download, fail fast and quiet.
  exit 127
fi
if [ -n "$version" ] && [ "$os" != unknown ] && [ "$arch" != unknown ]; then
  base="${IMPECCINO_DOWNLOAD_BASE:-https://github.com/sebastian-software/impeccino/releases/download}"
  asset="impeccino-$os-$arch"
  [ "$os" = windows ] && asset="$asset.exe"
  url="$base/engine-v$version/$asset"
  tmp="$cache_root/bin/$version/.impeccino.part.$$"
  if ! mkdir -p "$cache_root/bin/$version" 2>/dev/null; then
    echo "impeccino: engine $version is not installed; cannot create cache directory: $cache_root/bin/$version" >&2
    setup_help
    exit 127
  fi
  # Check the actual staging file, not just directory existence: a cache from
  # an earlier run can be readable but no longer writable inside a sandbox.
  if ! (umask 077; : > "$tmp") 2>/dev/null; then
    echo "impeccino: engine $version is not installed; cannot write to cache directory: $cache_root/bin/$version" >&2
    setup_help
    exit 127
  fi
  # Only a version the skill pins can be verified; refuse before downloading.
  if ! grep -qF "  engine-v$version/" "$dir/engine.sha256" 2>/dev/null; then
    rm -f "$tmp" 2>/dev/null
    echo "impeccino: no digest pinned for engine-v$version in $dir/engine.sha256; refusing to download an unverified engine. Use a released skill version, or build the engine and set IMPECCINO_BIN." >&2
    exit 127
  fi
  fetched=0
  if fetch_url "$url"; then
    fetched=1
  elif [ "$os" = windows ] && [ "$arch" = arm64 ]; then
    # Windows on ARM runs x64 binaries; fall back when no arm64 asset exists.
    url="$base/engine-v$version/impeccino-windows-x64.exe"
    fetch_url "$url" && fetched=1
  fi
  if [ "$fetched" = 1 ]; then
    check_download
    # Fail closed: a freshly downloaded binary runs only after matching the
    # digest the skill pins for it in engine.sha256 (written by
    # scripts/pin-engine.mjs after verifying the GitHub build attestation), so
    # a pinned skill commit pins the bytes. No pin for this version, or a
    # machine with no sha256 tool, refuses the download instead of exec'ing
    # an unverified binary. (A binary already on PATH or in the cache that
    # passes engine-probe is unaffected.)
    pins="$dir/engine.sha256"
    expected=""
    if [ -f "$pins" ]; then
      key="engine-v$version/${url##*/}"
      expected=$(awk -v k="$key" '$2 == k { print $1; exit }' "$pins" 2>/dev/null || true)
    fi
    actual=""
    if command -v shasum >/dev/null 2>&1; then
      if digest=$(shasum -a 256 "$tmp" 2>/dev/null); then actual=${digest%% *}; fi
    elif command -v sha256sum >/dev/null 2>&1; then
      if digest=$(sha256sum "$tmp" 2>/dev/null); then actual=${digest%% *}; fi
    fi
    check_download
    if [ -z "$expected" ]; then
      rm -f "$tmp"
      echo "impeccino: no digest pinned for engine-v$version/${url##*/} in $pins; refusing the unverified download. Use a released skill version, or build the engine and set IMPECCINO_BIN." >&2
      exit 127
    fi
    if [ -z "$actual" ]; then
      rm -f "$tmp"
      echo "impeccino: cannot hash $url (no shasum or sha256sum); refusing the unverified download" >&2
      exit 127
    fi
    if [ "$actual" != "$expected" ]; then
      rm -f "$tmp"
      echo "impeccino: checksum mismatch downloading $url (pinned in $pins)" >&2
      exit 127
    fi
    check_download
    if ! chmod +x "$tmp" 2>/dev/null; then
      check_download
      rm -f "$tmp"
      echo "impeccino: could not make the verified download executable: $url" >&2
      exit 127
    fi
    check_download
    if ! mv -f "$tmp" "$cached" 2>/dev/null; then
      check_download
      rm -f "$tmp"
      echo "impeccino: could not cache the verified download: $url" >&2
      exit 127
    fi
    check_download "$cached"
    exec "$cached" "$@"
  fi
  rm -f "$tmp" 2>/dev/null
  echo "impeccino: could not download engine $version from $url; check network access, the release URL, and curl or wget availability." >&2
  setup_help
  exit 127
fi

echo "impeccino: no engine binary for $os-$arch found (looked in $bin, $cached, PATH)." >&2
echo "Download impeccino-$os-$arch from https://github.com/sebastian-software/impeccino/releases (tag engine-v$version) into $cache_root/bin/$version/impeccino$exe (then chmod +x), or set IMPECCINO_BIN to a preinstalled engine binary." >&2
exit 127
