{
  "name": "impeccino",
  "version": "4.1.0",
  "private": true,
  "description": "Impeccino: design skill, commands, and anti-pattern detection for AI coding agents (repository tooling)",
  "author": "Sebastian Werner",
  "contributors": [
    "Paul Bakaus (Impeccable, the project Impeccino derives from)"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sebastian-software/impeccino.git"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "type": "module",
  "scripts": {
    "check": "node scripts/check.js",
    "fetch:engine": "node scripts/fetch-engine.mjs",
    "test": "node scripts/run-tests.mjs default",
    "test:core": "node scripts/run-tests.mjs core",
    "test:oracle": "node scripts/run-tests.mjs oracle",
    "test:skill-behavior": "node scripts/run-tests.mjs skill-behavior",
    "test:skill-workflow": "node scripts/run-tests.mjs skill-workflow",
    "audit": "pnpm audit --audit-level=moderate",
    "release:skill": "node scripts/release.mjs skill",
    "release:engine": "node scripts/release.mjs engine",
    "check:engine-release": "node scripts/check-engine-release.mjs",
    "pin:engine": "node scripts/pin-engine.mjs"
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "^4.0.7",
    "@ai-sdk/google": "^4.0.8",
    "@ai-sdk/openai": "^4.0.7",
    "ai": "^7.0.14",
    "playwright": "^1.59.1",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1",
    "zod": "^4.3.6"
  },
  "packageManager": "pnpm@12.8.1"
}
