# Dependencies (bun.lock is tracked; npm may write a package-lock.json as a
# side effect of subprocesses)
node_modules/
package-lock.json

# Cargo (Cargo.lock IS tracked, it pins the engine build)
/target/

*.log
tmp/

# OS and editor files
.DS_Store
Thumbs.db
.vscode/
.idea/

# Environment
.env
.env.local

# Impeccino project state while developing here: runtime state and per-run
# critique snapshots stay local; config.json and critique/ignore.md are shared.
**/.impeccino/hook.cache.json
**/.impeccino/hook.pending.json
.impeccino/config.local.json
.impeccino/critique/*
!.impeccino/critique/ignore.md

# Engine binaries: fetched per platform (scripts/fetch-engine.mjs), never tracked.
# The launcher next to them (skill/scripts/impeccino) is the tracked file.
skill/scripts/bin/

# Harness folders at the repo root are local developer state, never shipped:
# skill/ itself is the install payload for every harness.
/.agent/
/.agents/
/.claude/
/.codex/
/.cursor/
/.gemini/
/.grok/
/.hermes/
/.kiro/
/.opencode/
/.pi/
/.qoder/
/.rovodev/
/.trae/
/.veto/
/.vibe/
