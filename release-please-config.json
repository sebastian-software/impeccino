{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "packages": {
    ".": {
      "component": "engine",
      "include-component-in-tag": true,
      "tag-separator": "-",
      "version-file": ".release-please-version",
      "changelog-path": "CHANGELOG.md",
      "draft": true,
      "force-tag-creation": true,
      "bump-minor-pre-major": true,
      "bump-patch-for-minor-pre-major": false,
      "pull-request-footer": "AI assistance: Codex helped implement this release automation.",
      "extra-files": [
        { "type": "toml", "path": "Cargo.toml", "jsonpath": "$.workspace.package.version" },
        { "type": "toml", "path": "Cargo.lock", "jsonpath": "$.package[?(@.name.value==\"impeccino\")].version" },
        { "type": "toml", "path": "Cargo.lock", "jsonpath": "$.package[?(@.name.value==\"impeccino-common\")].version" },
        { "type": "toml", "path": "Cargo.lock", "jsonpath": "$.package[?(@.name.value==\"impeccino-context\")].version" },
        { "type": "toml", "path": "Cargo.lock", "jsonpath": "$.package[?(@.name.value==\"impeccino-core\")].version" },
        { "type": "toml", "path": "Cargo.lock", "jsonpath": "$.package[?(@.name.value==\"impeccino-detect\")].version" },
        { "type": "toml", "path": "Cargo.lock", "jsonpath": "$.package[?(@.name.value==\"impeccino-foundation\")].version" },
        { "type": "toml", "path": "Cargo.lock", "jsonpath": "$.package[?(@.name.value==\"impeccino-hook\")].version" },
        { "type": "toml", "path": "Cargo.lock", "jsonpath": "$.package[?(@.name.value==\"impeccino-html\")].version" }
      ]
    }
  }
}
